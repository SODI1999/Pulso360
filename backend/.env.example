# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pulso360_db
DB_USER=pulso360_app
DB_PASSWORD=
# Mantenimiento: DB_MIGRATION_USER y DB_MIGRATION_PASSWORD solo en .env.maintenance.
# Solo pruebas: debe ser una base distinta de DB_NAME, sin datos reales.
DB_NAME_TEST=pulso360_plan_test_20261005
# La suite crea fixtures y disparadores en la base separada:
# guardar DB_TEST_USER y DB_TEST_PASSWORD solo en .env.test.

# Seguridad y Autenticación JWT
# Generar una clave aleatoria exclusiva (mínimo 32 caracteres); nunca copiar una clave pública.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS (Frontend Vite de desarrollo)
CORS_ORIGIN=http://localhost:5173

# Recuperación por SMTP: configuración exclusiva del servidor.
# Puerto 465 usa TLS directo; los demás requieren STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_FRONTEND_URL=http://localhost:5173

# Activar solo después de aplicar 004_weekly_alert_job en una base autorizada.
# Semanas lunes-domingo; evaluación desde lunes 06:00 America/Bogota.
ALERT_JOB_ENABLED=false
