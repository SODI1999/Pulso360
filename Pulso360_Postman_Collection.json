  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ==============================================================================",
          "// SCRIPT GLOBAL DE EVALUACIÓN DE RESPUESTAS PARA CREATE Y UPDATE",
          "// Audita automáticamente TODOS los endpoints POST, PUT y PATCH del proyecto",
          "// ==============================================================================",
          "const method = pm.request.method;",
          "const isCreate = method === 'POST';",
          "const isUpdate = method === 'PUT' || method === 'PATCH';",
          "",
          "if (isCreate || isUpdate) {",
          "    const op = isCreate ? 'CREATE (POST)' : 'UPDATE (' + method + ')';",
          "    const statusCode = pm.response.code;",
          "    let res;",
          "",
          "    // 1. Cabecera Content-Type estándar",
          "    pm.test(`[${op}] Cabecera Content-Type contiene application/json`, function () {",
          "        pm.expect(pm.response.headers.get('content-type')).to.include('application/json');",
          "    });",
          "",
          "    // 2. Control de Latencia (RNF-02)",
          "    pm.test(`[${op}] Tiempo de respuesta menor a 2000ms`, function () {",
          "        pm.expect(pm.response.responseTime).to.be.below(2000);",
          "    });",
          "",
          "    // 3. Integridad de Parseo JSON",
          "    try {",
          "        res = pm.response.json();",
          "    } catch (err) {",
          "        pm.test(`[${op}] El servidor debe retornar JSON parseable`, function () {",
          "            pm.expect.fail('Respuesta no JSON: ' + pm.response.text());",
          "        });",
          "        return;",
          "    }",
          "",
          "    // 4. Auditoría de Respuestas Exitosas (2xx)",
          "    if (statusCode >= 200 && statusCode < 300) {",
          "        pm.test(`[${op}] Sobre canónico SDD de éxito: success=true y data válida`, function () {",
          "            pm.expect(res.success).to.be.true;",
          "            pm.expect(res).to.have.property('data');",
          "            pm.expect(res.data).to.not.be.null;",
          "        });",
          "",
          "        pm.test(`[${op}] Seguridad y Privacidad: Cero fuga de contrasena_hash`, function () {",
          "            const raw = JSON.stringify(res);",
          "            pm.expect(raw).to.not.include('contrasena_hash');",
          "            pm.expect(raw).to.not.include('password_hash');",
          "        });",
          "",
          "        if (isCreate) {",
          "            pm.test(`[CREATE] Código HTTP válido (200 o 201)`, function () {",
          "                pm.expect(statusCode).to.be.oneOf([200, 201]);",
          "            });",
          "        }",
          "",
          "        if (isUpdate) {",
          "            pm.test(`[UPDATE] Código 200 OK y confirmación de mutación`, function () {",
          "                pm.expect(statusCode).to.equal(200);",
          "                pm.expect(res.data).to.not.be.null;",
          "            });",
          "        }",
          "    }",
          "    // 5. Auditoría de Respuestas de Error Controladas (4xx / 5xx)",
          "    else {",
          "        pm.test(`[${op}] Sobre canónico SDD de error: success=false con error.code y error.message`, function () {",
          "            pm.expect(res.success).to.be.false;",
          "            pm.expect(res.error).to.be.an('object');",
          "            pm.expect(res.error.code).to.be.a('string').and.not.empty;",
          "            pm.expect(res.error.message).to.be.a('string').and.not.empty;",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
