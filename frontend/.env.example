# Pulso360 - Variables de Entorno (Plantilla de configuración)
# Copia este archivo a .env y define los valores específicos para tu entorno local.
# En Vite, solo las variables que inicien con VITE_ son expuestas al cliente web.


# Nombre y Entorno de la Aplicación
VITE_APP_TITLE="Pulso360 - Prevención de Burnout BPO"
VITE_APP_ENV="development"

# URL de la API Backend (Futura conexión a PostgreSQL / Backend REST API)
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Persistencia Local (Simulación DAO / Repository)
VITE_STORAGE_KEY="pulso360_data_v2"
VITE_USE_MOCK_STORAGE="true"

# Parámetros de Gobernanza y Privacidad
VITE_DEFAULT_POLICY_VERSION="v2.4"
VITE_DEFAULT_POLICY_DATE="15/08/2026"
